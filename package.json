{
  "name": "drivovo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "nx dev web",
    "dev:api": "nx serve api",
    "dev:all": "nx run-many --target=serve --projects=web,api --parallel",
    "build": "nx build web",
    "build:api": "nx build api",
    "build:all": "nx run-many --target=build --projects=web,api",
    "start": "nx start web",
    "start:api": "node dist/apps/api/main.js",
    "api:dev": "npm run dev:api",
    "api:build": "npm run build:api",
    "api:start": "npm run start:api",
    "api:prod": "npm run build:api && npm run start:api",
    "api:clean": "rimraf dist/apps/api",
    "api:watch": "nx serve api --watch",
    "lint": "eslint apps/web",
    "lint:api": "eslint apps/api",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@fastify/cors": "^11.2.0",
    "@fastify/postgres": "^6.0.2",
    "dotenv": "^17.3.1",
    "fastify": "^5.7.4",
    "fastify-plugin": "^5.1.0",
    "next": "^16.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@nx/esbuild": "22.5.1",
    "@nx/js": "22.5.1",
    "@nx/next": "22.5.1",
    "@nx/node": "22.5.1",
    "@nx/workspace": "22.5.1",
    "@swc-node/register": "~1.11.1",
    "@swc/core": "~1.15.5",
    "@swc/helpers": "~0.5.18",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.16.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "esbuild": "^0.19.2",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.0.0",
    "eslint-config-prettier": "^9.1.0",
    "globals": "^15.15.0",
    "nx": "22.5.1",
    "pino-pretty": "^13.1.3",
    "postcss": "^8.4.49",
    "prettier": "~3.6.2",
    "rimraf": "^6.1.3",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.55.0"
  }
}
